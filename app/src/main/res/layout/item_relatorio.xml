<?xml version="1.0" encoding="utf-8"?>
<!--Cartão de um relatório na lista da família-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/azul_claro_bem_me_quer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/item_relatorio_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/azul_bem_me_quer"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_relatorio_autor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cinza_texto"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/item_relatorio_relato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
