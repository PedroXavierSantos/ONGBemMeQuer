<?xml version="1.0" encoding="utf-8"?>
<!--Cartão de um dia na faixa "Últimos 15 dias" (criado pelo código, um para cada dia)-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    app:cardBackgroundColor="@color/roxo_claro_bem_me_quer"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/dia_semana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            tools:text="SEG" />

        <TextView
            android:id="@+id/dia_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/roxo_bem_me_quer"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="10/11" />

        <TextView
            android:id="@+id/dia_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Completo"
            tools:textColor="@color/verde_finalizar" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
