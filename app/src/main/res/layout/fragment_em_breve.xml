<?xml version="1.0" encoding="utf-8"?>
<!--Tela provisória para as abas que ainda estão em desenvolvimento-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/em_breve_icone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no"
        app:tint="@color/azul_bem_me_quer" />

    <TextView
        android:id="@+id/em_breve_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/azul_bem_me_quer"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/emBreveDescricao"
        android:textColor="@color/cinza_texto"
        android:textSize="15sp" />
</LinearLayout>
