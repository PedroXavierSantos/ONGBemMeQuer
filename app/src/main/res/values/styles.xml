<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--Estilos reaproveitados na aba Perfil (rótulo cinza em cima, valor preto embaixo).
        Sem ponto no nome: no Android, "A.B" significa que B herda de um estilo A.-->
    <style name="PerfilRotulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/cinza_texto</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PerfilValor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">17sp</item>
        <item name="android:text">@string/carregando</item>
    </style>

    <!--Título roxo de cada seção da tela inicial do funcionário (Status de Hoje, Últimos 15 dias...)-->
    <style name="TituloSecaoFuncionario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/roxo_bem_me_quer</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
