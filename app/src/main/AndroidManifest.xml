<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".BemMeQuerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BemMeQuer"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainFuncionarioActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cadastroDoisActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cadastroUmActivity"
            android:exported="false" />
        <activity
            android:name=".ui.mainPacienteActivity"
            android:exported="false" />
        <activity
            android:name=".ui.paciente.RelatoriosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.funcionario.NovoRelatorioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.funcionario.MeusRelatoriosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.loginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--Empresta um arquivo do cache (o PDF do relatório) para outro app, só para leitura e só
            enquanto durar o compartilhamento. As pastas liberadas estão em res/xml/caminhos_compartilhados.xml-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/caminhos_compartilhados" />
        </provider>
    </application>

</manifest>